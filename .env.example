# .env.example - contains no real credentials.
# Copy this file to .env and put your own key in .env (which is git-ignored).

# Anthropic API key from https://console.anthropic.com
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Claude model used by ClaudeClient (Haiku is the cheapest)
LLM_MODEL=claude-haiku-5-5

# Seconds to wait for Claude before treating it as unavailable
LLM_TIMEOUT_SECONDS=30

# Where the local database file is stored
DB_PATH=data/finance-db.json
